# CogniVault — PRODUCTION ortam dosyası örneği.
#
#   cp .env.prod.example .env.prod   &&   düzenle   &&   ./scripts/prod/deploy.sh
#
# .env.prod ASLA commit'lenmez (.gitignore'da). Dağıtımdan önce
# `python -m app.ops.preflight --check-env` bu profili denetler; bloke eden
# bulgu varsa deploy script'i durur.

# ── Zorunlu: kimlik ve alan adı ──────────────────────────────────────────────
ENVIRONMENT=production
# Kliniğin gerçek alan adı. DNS A kaydı bu sunucuya bakmalı; Caddy sertifikayı
# buna göre alır ve Twilio imzası bu URL üzerinden doğrulanır.
COGNIVAULT_DOMAIN=klinik.example.com
# Let's Encrypt sertifika bildirimleri (yenileme hatası buraya düşer).
ACME_EMAIL=operasyon@example.com

# ── Zorunlu: sırlar ──────────────────────────────────────────────────────────
# En az 32 karakter, tahmin edilemez. Üretmek için:  openssl rand -base64 48
# Zayıf/varsayılan secret production'da guard tarafından REDDEDİLİR.
JWT_SECRET=
POSTGRES_DB=cognivault
POSTGRES_USER=cognivault
# openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Prod güvenlik kapıları (değiştirmeyin) ───────────────────────────────────
# Şema yalnız açık `alembic upgrade head` ile değişir; demo verisi tohumlanmaz.
AUTO_CREATE_SCHEMA=false
SEED_DEMO_DATA=false
# Gelen webhook'lar imzasız kabul edilmez (Twilio X-Twilio-Signature,
# Meta X-Hub-Signature-256).
CLINICAL_WEBHOOK_SIGNATURE_REQUIRED=true
# Numara→klinik eşlemesi olmayan çağrı reddedilir; default kliniğe DÜŞMEZ.
# Çok kiracılı canlı kurulumda zorunlu (bkz. app/ops/bind_channel.py).
CLINICAL_CHANNEL_BINDING_STRICT=true

# ── KVKK / veri yerleşimi ────────────────────────────────────────────────────
# Varsayılan yerel-öncelik. Sınır-ötesi işlemci hem klinik izni HEM hasta açık
# rızası ister (bkz. clinical_ai_service._try_runtime_reply).
CLINICAL_DATA_RESIDENCY_DEFAULT=tr_local_first
CLINICAL_EXTERNAL_AI_ALLOWED=false
VOICE_EXTERNAL_ENABLED=false

# ── Yerel LLM (opsiyonel; yoksa deterministik motor çalışır) ─────────────────
# Sunucuda Ollama/vLLM varsa OpenAI-uyumlu endpoint'i verin. BOŞ bırakılırsa ve
# PREFERRED_LLM_PROVIDER=auto ise sistem OpenAI'a düşmeye çalışır — KVKK açısından
# istemiyorsanız `local` bırakın.
PREFERRED_LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen2.5:3b-instruct
CLINICAL_AI_ENABLED=true

# ── Telefon / SMS (F1 — gerçek +90 hattı) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VOICE_PHONE_NATIVE_TTS_ENABLED=true
SMS_PROVIDER=netgsm
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# ── İşletim ──────────────────────────────────────────────────────────────────
# Klinik on-prem kutusu genelde 2-4 çekirdek; çekirdek başına ~1 worker.
UVICORN_WORKERS=2
# Yedek provası aralığı (saniye). 86400 = günde bir.
BACKUP_INTERVAL_SECONDS=86400
