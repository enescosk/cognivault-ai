# ============================================================================
# CogniVault AI — Environment Variables Template
# ============================================================================
# Bu dosyayı kopyala: `cp .env.example .env` ve gerçek değerlerle doldur.
#
# .env DOSYASI ASLA git'e EKLENMEMELI (.gitignore zaten içeriyor).
# Production'da bu değişkenler container/secret manager üzerinden geçirilmeli;
# diske `.env` koymak yerine env injection tercih edin.
# ============================================================================

# ── Environment ─────────────────────────────────────────────────────────────
# development | staging | production
# Production'da güvenlik fail-fast'leri etkinleşir:
#   - zayıf JWT_SECRET reddedilir (uygulama başlamaz)
#   - SEED_DEMO_DATA=true olsa bile demo data oluşturulmaz
#   - webhook imza doğrulaması zorunlu olur
ENVIRONMENT=development

# ── Database ────────────────────────────────────────────────────────────────
# Dev için SQLite varsayılan. Prod için: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///data/cognivault.db
POSTGRES_DB=cognivault
POSTGRES_USER=cognivault
POSTGRES_PASSWORD=cognivault

# ── Security ────────────────────────────────────────────────────────────────
# JWT_SECRET production'da en az 32 karakter, yüksek entropili olmalı.
# Güçlü secret üret:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Aşağıdaki "replace-me" production'da uygulamayı BAŞLATMAZ (fail-fast).
JWT_SECRET=replace-me

# Demo data — production'da false. Geliştirme/test için true.
SEED_DEMO_DATA=true

# Webhook imza doğrulaması — production'da zaten zorunlu (kod zorlar).
CLINICAL_WEBHOOK_SIGNATURE_REQUIRED=false

# ── LLM (OpenAI) ────────────────────────────────────────────────────────────
# UYARI: Klinik PHI verisi için standart OpenAI API'si HIPAA-uyumsuz.
# Production'da Azure OpenAI Service (BAA imzalı) tercih et.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── LLM (Anthropic) ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_INTENT_MODEL=claude-haiku-4-5-20251001
# "auto" tries Anthropic first when key present, then OpenAI, then local rules
PREFERRED_AGENT_PROVIDER=auto
CLINICAL_AI_ENABLED=false
# Astra receptionist drafts; clinical + patient permission are still required.
# auto keeps the existing provider preference; local never selects cloud AI.
CLINICAL_LLM_PROVIDER=auto
CLINICAL_ASTRA_MODEL=gpt-6-astra
CLINICAL_ASTRA_REASONING=low
CLINICAL_ASTRA_TIMEOUT=15
CLINICAL_ASTRA_MAX_OUTPUT_TOKENS=1800
CLINICAL_EXTERNAL_AI_ALLOWED=false
# Uygulama seviyesi dış ses işleme ana şalteri. false iken klinik ne kaydederse
# kaydetsin ses yurt içinde (Piper) üretilir; ElevenLabs için true olmalı.
VOICE_EXTERNAL_ENABLED=false

# ── ElevenLabs sesi (opsiyonel, premium TR ses) ─────────────────────────────
# Canlı hasta görüşmesinin ElevenLabs ile konuşması için gereken dört koşul:
#   1) ELEVENLABS_API_KEY dolu            (aşağıda)
#   2) VOICE_EXTERNAL_ENABLED=true        (yukarıdaki ana şalter)
#   3) Klinik, Voice Studio'da sesi "canlı görüşmelerde kullan" ile kaydetmiş
#   4) Hasta o görüşmede ses + sınır-ötesi rızasını vermiş
# Biri bile eksikse ses sessizce yerel Piper'a düşer; eksikler Voice Studio'daki
# "Canlı sese geçiş için:" satırında listelenir.
# Ses/model/hız/tonlama .env'de DEĞİL, klinik profilinde tutulur (Voice Studio → kaydet).
ELEVENLABS_API_KEY=
# Voice Studio'dan ses seçilmeden önceki yedek ses kimliği (opsiyonel).
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 (en doğal) | eleven_flash_v2_5 (en hızlı) | eleven_turbo_v2_5
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
CLINICAL_DEFAULT_CLINIC_SLUG=demo-klinik
CLINICAL_AUTO_REPLY_THRESHOLD=0.90
CLINICAL_SHADOW_THRESHOLD=0.75

# ── Twilio (WhatsApp + Voice) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Meta (WhatsApp Cloud API) ───────────────────────────────────────────────
# META_APP_SECRET X-Hub-Signature-256 doğrulaması için zorunlu (prod).
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=

# ── Klinik WhatsApp cevap gönderimi ─────────────────────────────────────────
# Varsayılan KAPALI: cevaplar üretilir ama "demo_only" işaretlenir, hiçbir
# numaraya gitmez. Açınca cevap, hastanın yazdığı işletme numarasından gider
# (Twilio: gelen "To"; Meta: gelen phone_number_id). Gönderimi outbox worker
# yapar: `python -m app.workers.outbox_worker` çalışmalı.
# Twilio teslim bildirimleri için CLINICAL_WEBHOOK_BASE_URL dolu olmalı
# (StatusCallback → /api/webhooks/whatsapp/status).
CLINIC_WHATSAPP_SEND_ENABLED=false

# ── Intelligence / External Discovery ───────────────────────────────────────
INTELLIGENCE_EXTERNAL_ENABLED=false
GOOGLE_PLACES_API_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────
# Production'da sadece kendi frontend domain'in. Asla "*" KULLANMA.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5200,http://127.0.0.1:5200,http://localhost:8080

# ── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api

# ── E-posta (opsiyonel) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cognivault.local

# ── SMS (randevu onayları) ──────────────────────────────────────────────────
# mock: konsol simülasyonu (varsayılan). netgsm: gerçek gönderim — üç alan da
# zorunlu (Netgsm usercode/password + operatör onaylı başlık). Kimlik eksikse
# uygulama yüksek sesle loglayıp mock'a düşer; /health/ready "fail" gösterir.
SMS_PROVIDER=mock
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# ── Çoklu kiracı kanal eşlemesi ─────────────────────────────────────────────
# true: aranan numara/WABA kimliği hiçbir kliniğe bağlı değilse webhook REDDEDİLİR
# (çoklu klinik pilotu). false: demo default kliniğe düşer (tek klinik).
CLINICAL_CHANNEL_BINDING_STRICT=false

# ── Telefon native TTS ──────────────────────────────────────────────────────
# true: TwiML yanıtları kendi lokal TTS'imizle (<Play>, fahrettin) çalınır.
# false: Twilio <Say voice="alice"> fallback'i (kill-switch).
VOICE_PHONE_NATIVE_TTS_ENABLED=true

# Optional automotive inbound bridge. Off by default; only your own configured
# dispatcher can receive calls. Separate from clinical voice routes.
AUTOMOTIVE_VOICE_ENABLED=false
AUTOMOTIVE_INBOUND_NUMBER=
AUTOMOTIVE_DISPATCH_NUMBER=
AUTOMOTIVE_WEBHOOK_BASE_URL=

# ── Yol yardım hattı (telefon + WhatsApp → iş → çekici) ─────────────────────
# Ayrıntı ve şablon metinleri: docs/automotive/YOL-YARDIMI.md
# Gelen işlerin sahibi dispeç hesabı; boşsa gelen kanal iş AÇMAZ.
AUTOMOTIVE_INBOUND_OWNER_EMAIL=
AUTOMOTIVE_BRAND=Atlas Yol Yardım
AUTOMOTIVE_SERVICE_NAME=Atlas Oto Servis
# Varsayılan KAPALI: kapalıyken mesajlar yalnız kayda "demo_only" yazılır.
AUTOMOTIVE_WHATSAPP_ENABLED=false
AUTOMOTIVE_WHATSAPP_PHONE_NUMBER_ID=
AUTOMOTIVE_META_ACCESS_TOKEN=
AUTOMOTIVE_META_APP_SECRET=
AUTOMOTIVE_META_VERIFY_TOKEN=
AUTOMOTIVE_WA_TEMPLATE_LANGUAGE=tr
AUTOMOTIVE_WA_TEMPLATE_CUSTOMER_LOCATION=
AUTOMOTIVE_WA_TEMPLATE_CUSTOMER_UPDATE=
AUTOMOTIVE_WA_TEMPLATE_TEAM_OFFER=
# {"atlas-01": "+90...", "atlas-02": "+90..."} — koda sabit numara yazılmaz.
AUTOMOTIVE_TEAM_PHONES=
